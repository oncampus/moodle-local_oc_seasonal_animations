{{!
    @template local_oc_seasonal_animations/setting_random_span

    Setting type randomspan.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * name -> Name of the config
    * min -> Current minimum of range
    * max -> Current maximum of range
    * size -> Size of the text inputs
    * readonly -> If form elements should be disabled

    Example context (json):
    {
        "name": "behavior_move_vertical_random_span",
        "min": 10,
        "max": 30,
        "size": 5,
        "readonly": false
    }
}}

{{#name}}
<div class="form-text defaultsnext d-flex align-items-center gap-2">
    <label for="{{name}}_min">{{#str}} min, local_oc_seasonal_animations{{/str}}</label>
    <input
            id="{{name}}_min"
            type="text"
            name="{{name}}[min]"
            value="{{min}}"
            {{#size}} size="{{size}}" {{/size}}
            class="form-control"
           {{#readonly}}disabled{{/readonly}}
    >
    <label for="{{name}}_max">{{#str}} max, local_oc_seasonal_animations{{/str}}</label>
    <input
            id="{{name}}_max"
            type="text"
            name="{{name}}[max]"
            value="{{max}}"
            {{#size}} size="{{size}}" {{/size}}
            class="form-control"
           {{#readonly}}disabled{{/readonly}}
    >
</div>
{{/name}}
