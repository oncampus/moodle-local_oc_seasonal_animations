{{!
    Setting randomspan.
}}
<div class="form-text defaultsnext">
    <label for="{{name}}[min]">{{#str}} min, local_oc_seasonal_animations{{/str}}</label>
    <input type="text" name="{{name}}[min]" value="{{min}}" size="{{size}}" class="form-control ml-1"
           {{#readonly}}disabled{{/readonly}}>
    <label for="{{name}}[max]">{{#str}} max, local_oc_seasonal_animations{{/str}}</label>
    <input type="text" name="{{name}}[max]" value="{{max}}" size="{{size}}" class="form-control ml-1"
           {{#readonly}}disabled{{/readonly}}>
</div>
